{
  "name": "MAGIC fixed-gain SGDM five-seed confirmation",
  "on": {
    "push": {
      "branches": [
        "magic-fixed-gain-sgdm-confirm-20261127"
      ],
      "paths": [
        ".github/workflows/magic-fixed-gain-sgdm-confirm.yml"
      ]
    }
  },
  "permissions": {
    "contents": "write"
  },
  "concurrency": {
    "group": "magic-fixed-gain-sgdm-confirm",
    "cancel-in-progress": false
  },
  "env": {
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "NUMEXPR_NUM_THREADS": "1",
    "MPLBACKEND": "Agg",
    "PYTHONHASHSEED": "0"
  },
  "jobs": {
    "gate": {
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 25,
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "sparse-checkout": "/experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/\n/experiments/single_matrix_benchmarks/magic/prepared/\n/experiments/single_matrix_benchmarks/magic/source/\n/experiments/single_matrix_benchmarks/magic/requirements.txt\n/experiments/single_matrix_benchmarks/magic/plan.json",
            "sparse-checkout-cone-mode": false
          }
        },
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version": "3.12.9"
          }
        },
        {
          "name": "Install pinned dependencies",
          "run": "python -m pip install -r \"experiments/single_matrix_benchmarks/magic/requirements.txt\""
        },
        {
          "name": "Verify exact data, frozen gains, zero-training numerical symmetry and five-run cap",
          "run": "set -euo pipefail\npython -m py_compile \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/model.py\" \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/run.py\" \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/preflight.py\" \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/audit.py\"\npython \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/preflight.py\" | tee \"$RUNNER_TEMP/preflight.json\"\npython \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/run.py\" > \"$RUNNER_TEMP/dry_run.json\"\npython -c 'import json,sys; j=json.load(open(sys.argv[1])); assert not j[\"grid\"] and len(j[\"confirmation\"])==5 and all(x[\"track\"]==\"sgdm_wd0\" and x[\"updates\"]==20000 for x in j[\"confirmation\"])' \"$RUNNER_TEMP/dry_run.json\""
        },
        {
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "confirmation-preflight",
            "path": "${{ runner.temp }}/preflight.json\n${{ runner.temp }}/dry_run.json",
            "if-no-files-found": "error"
          }
        }
      ]
    },
    "confirm": {
      "needs": "gate",
      "if": "${{ github.run_attempt == 1 }}",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 75,
      "strategy": {
        "fail-fast": false,
        "max-parallel": 5,
        "matrix": {
          "seed": [
            3472,
            3473,
            3474,
            3475,
            3476
          ]
        }
      },
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "sparse-checkout": "/experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/\n/experiments/single_matrix_benchmarks/magic/prepared/\n/experiments/single_matrix_benchmarks/magic/source/\n/experiments/single_matrix_benchmarks/magic/requirements.txt\n/experiments/single_matrix_benchmarks/magic/plan.json",
            "sparse-checkout-cone-mode": false
          }
        },
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version": "3.12.9"
          }
        },
        {
          "name": "Install pinned dependencies",
          "run": "python -m pip install -r \"experiments/single_matrix_benchmarks/magic/requirements.txt\""
        },
        {
          "name": "One fixed 20k SGDM confirmation seed",
          "timeout-minutes": 65,
          "run": "python \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/run.py\" --execute-training --phase confirm --case sgdm_wd0 --seed \"${{ matrix.seed }}\""
        },
        {
          "if": "${{ always() }}",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "confirm-${{ matrix.seed }}",
            "path": "experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/results/confirm/sgdm_wd0-${{ matrix.seed }}/",
            "if-no-files-found": "warn",
            "retention-days": 14
          }
        }
      ]
    },
    "archive": {
      "needs": [
        "gate",
        "confirm"
      ],
      "if": "${{ always() && !cancelled() }}",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 35,
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "sparse-checkout": "/experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/\n/experiments/single_matrix_benchmarks/magic/prepared/\n/experiments/single_matrix_benchmarks/magic/source/\n/experiments/single_matrix_benchmarks/magic/requirements.txt\n/experiments/single_matrix_benchmarks/magic/plan.json\n/experiments/single_matrix_benchmarks/magic/results/confirm/adamw_wd0-3472/result.json\n/experiments/single_matrix_benchmarks/magic/results/confirm/adamw_wd0-3473/result.json\n/experiments/single_matrix_benchmarks/magic/results/confirm/adamw_wd0-3474/result.json\n/experiments/single_matrix_benchmarks/magic/results/confirm/adamw_wd0-3475/result.json\n/experiments/single_matrix_benchmarks/magic/results/confirm/adamw_wd0-3476/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/confirm/adamw_wd0-3472/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/confirm/adamw_wd0-3473/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/confirm/adamw_wd0-3474/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/confirm/adamw_wd0-3475/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/confirm/adamw_wd0-3476/result.json",
            "sparse-checkout-cone-mode": false,
            "ref": "magic-fixed-gain-sgdm-confirm-20261127"
          }
        },
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version": "3.12.9"
          }
        },
        {
          "name": "Install pinned dependencies",
          "run": "python -m pip install -r \"experiments/single_matrix_benchmarks/magic/requirements.txt\""
        },
        {
          "uses": "actions/download-artifact@v4",
          "with": {
            "name": "confirmation-preflight",
            "path": "experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/results/preflight"
          },
          "continue-on-error": true
        },
        {
          "uses": "actions/download-artifact@v4",
          "with": {
            "pattern": "confirm-*",
            "path": "experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/results/confirm",
            "merge-multiple": false
          },
          "continue-on-error": true
        },
        {
          "name": "Normalize artifact directories",
          "run": "set -euo pipefail\nroot=\"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/results/confirm\"\nmkdir -p \"$root\"\nfor dir in \"$root\"/confirm-*; do [ -d \"$dir\" ] || continue; name=\"$(basename \"$dir\")\"; dest=\"$root/sgdm_wd0-${name#confirm-}\"; test ! -e \"$dest\"; mv \"$dir\" \"$dest\"; done"
        },
        {
          "name": "Audit completed and partial results",
          "run": "python \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/audit.py\"",
          "continue-on-error": true
        },
        {
          "name": "Permanently commit all results",
          "run": "set -euo pipefail\ngit config user.name 'github-actions[bot]'\ngit config user.email '41898282+github-actions[bot]@users.noreply.github.com'\nif [ -d \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/results\" ]; then git add -f \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/results\"; git diff --cached --quiet || git commit -m 'Archive MAGIC fixed-gain SGDM five-seed confirmation'; git push origin HEAD:\"$GITHUB_REF_NAME\"; fi"
        },
        {
          "if": "${{ always() }}",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "confirmation-analysis",
            "path": "experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/results/analysis/",
            "if-no-files-found": "warn"
          }
        },
        {
          "name": "Require complete audit",
          "run": "python -c 'import json,sys; j=json.load(open(sys.argv[1])); assert j[\"complete\"] and j[\"n_completed\"]==5 and j[\"n_checkpoints\"]==30 and not j[\"errors\"]' \"experiments/single_matrix_benchmarks/magic_fixed_gain_sgdm_confirm/results/analysis/summary.json\""
        }
      ]
    }
  }
}
