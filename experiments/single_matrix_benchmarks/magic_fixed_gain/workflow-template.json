{
  "name": "MAGIC fixed-gain scale-invariant MLP",
  "on": {
    "push": {
      "branches": [
        "magic-fixed-gain-20261127"
      ],
      "paths": [
        ".github/workflows/magic-fixed-gain.yml"
      ]
    }
  },
  "permissions": {
    "contents": "write"
  },
  "concurrency": {
    "group": "magic-fixed-gain-training",
    "cancel-in-progress": false
  },
  "env": {
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "NUMEXPR_NUM_THREADS": "1",
    "PYTHONHASHSEED": "0",
    "MPLBACKEND": "Agg"
  },
  "jobs": {
    "gate": {
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 25,
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "sparse-checkout": "/experiments/single_matrix_benchmarks/magic_fixed_gain/\n/experiments/single_matrix_benchmarks/magic/prepared/\n/experiments/single_matrix_benchmarks/magic/source/\n/experiments/single_matrix_benchmarks/magic/requirements.txt\n/experiments/single_matrix_benchmarks/magic/plan.json",
            "sparse-checkout-cone-mode": false
          }
        },
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version": "3.12.9"
          }
        },
        {
          "name": "Pinned original dependencies",
          "run": "python -m pip install -r \"experiments/single_matrix_benchmarks/magic/requirements.txt\""
        },
        {
          "name": "Verify zero-training data, frozen gains and exact 14-run cap",
          "run": "set -euo pipefail\npython -m py_compile \"experiments/single_matrix_benchmarks/magic_fixed_gain/model.py\" \"experiments/single_matrix_benchmarks/magic_fixed_gain/run.py\" \"experiments/single_matrix_benchmarks/magic_fixed_gain/preflight.py\" \"experiments/single_matrix_benchmarks/magic_fixed_gain/audit.py\"\npython \"experiments/single_matrix_benchmarks/magic_fixed_gain/preflight.py\" | tee \"$RUNNER_TEMP/fixed_gain_preflight.json\"\npython \"experiments/single_matrix_benchmarks/magic_fixed_gain/run.py\" > \"$RUNNER_TEMP/fixed_gain_dry_run.json\"\npython -c 'import json,sys; j=json.load(open(sys.argv[1])); assert len(j[\"grid\"])==14 and not j[\"confirmation\"] and all(x[\"updates\"]==20000 for x in j[\"grid\"])' \"$RUNNER_TEMP/fixed_gain_dry_run.json\""
        },
        {
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "fixed-gain-preflight",
            "path": "${{ runner.temp }}/fixed_gain_preflight.json\n${{ runner.temp }}/fixed_gain_dry_run.json",
            "if-no-files-found": "error"
          }
        }
      ]
    },
    "grid": {
      "needs": "gate",
      "if": "${{ github.run_attempt == 1 }}",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 45,
      "strategy": {
        "fail-fast": false,
        "max-parallel": 5,
        "matrix": {
          "case": [
            "s0",
            "s1",
            "s2",
            "s3",
            "a0",
            "a1",
            "a2"
          ],
          "seed": [
            3470,
            3471
          ]
        }
      },
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "sparse-checkout": "/experiments/single_matrix_benchmarks/magic_fixed_gain/\n/experiments/single_matrix_benchmarks/magic/prepared/\n/experiments/single_matrix_benchmarks/magic/source/\n/experiments/single_matrix_benchmarks/magic/requirements.txt\n/experiments/single_matrix_benchmarks/magic/plan.json",
            "sparse-checkout-cone-mode": false
          }
        },
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version": "3.12.9"
          }
        },
        {
          "name": "Pinned original dependencies",
          "run": "python -m pip install -r \"experiments/single_matrix_benchmarks/magic/requirements.txt\""
        },
        {
          "name": "One validation-only fixed-20k run",
          "timeout-minutes": 40,
          "run": "python \"experiments/single_matrix_benchmarks/magic_fixed_gain/run.py\" --execute-training --phase grid --case \"${{ matrix.case }}\" --seed \"${{ matrix.seed }}\""
        },
        {
          "if": "${{ always() }}",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "grid-${{ matrix.case }}-${{ matrix.seed }}",
            "path": "experiments/single_matrix_benchmarks/magic_fixed_gain/results/grid/${{ matrix.case }}-${{ matrix.seed }}/",
            "if-no-files-found": "warn",
            "retention-days": 14
          }
        }
      ]
    },
    "archive": {
      "needs": [
        "gate",
        "grid"
      ],
      "if": "${{ always() && !cancelled() }}",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 35,
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "sparse-checkout": "/experiments/single_matrix_benchmarks/magic_fixed_gain/\n/experiments/single_matrix_benchmarks/magic/prepared/\n/experiments/single_matrix_benchmarks/magic/source/\n/experiments/single_matrix_benchmarks/magic/requirements.txt\n/experiments/single_matrix_benchmarks/magic/plan.json\n/experiments/single_matrix_benchmarks/magic/results/analysis/trajectory.csv\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/analysis/trajectories.csv\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/s0-3470/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/s0-3471/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/s1-3470/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/s1-3471/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/s2-3470/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/s2-3471/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/s3-3470/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/s3-3471/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/a0-3470/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/a0-3471/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/a1-3470/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/a1-3471/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/a2-3470/result.json\n/experiments/single_matrix_benchmarks/magic_scale_invariant/results/grid/a2-3471/result.json",
            "sparse-checkout-cone-mode": false,
            "ref": "magic-fixed-gain-20261127"
          }
        },
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "c4eda173b511cebd4d3809624c3e9fbba4884b5f",
            "path": "calibration_archive",
            "persist-credentials": false,
            "sparse-checkout": "/experiments/single_matrix_benchmarks/magic_scale_invariant/calibration/calibration.csv",
            "sparse-checkout-cone-mode": false
          }
        },
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version": "3.12.9"
          }
        },
        {
          "name": "Pinned original dependencies",
          "run": "python -m pip install -r \"experiments/single_matrix_benchmarks/magic/requirements.txt\""
        },
        {
          "name": "Verify calibration control commit",
          "run": "test \"$(git -C calibration_archive rev-parse HEAD)\" = \"c4eda173b511cebd4d3809624c3e9fbba4884b5f\""
        },
        {
          "uses": "actions/download-artifact@v4",
          "with": {
            "name": "fixed-gain-preflight",
            "path": "experiments/single_matrix_benchmarks/magic_fixed_gain/results/preflight"
          },
          "continue-on-error": true
        },
        {
          "uses": "actions/download-artifact@v4",
          "with": {
            "pattern": "grid-*",
            "path": "experiments/single_matrix_benchmarks/magic_fixed_gain/results/grid",
            "merge-multiple": false
          },
          "continue-on-error": true
        },
        {
          "name": "Normalize downloaded folders",
          "run": "set -euo pipefail\nroot=\"experiments/single_matrix_benchmarks/magic_fixed_gain/results/grid\"\nmkdir -p \"$root\"\nfor d in \"$root\"/grid-*; do [ -d \"$d\" ] || continue; dest=\"$root/$(basename \"$d\" | sed 's/^grid-//')\"; test ! -e \"$dest\"; mv \"$d\" \"$dest\"; done"
        },
        {
          "name": "Audit and summarize complete or partial grid",
          "run": "python \"experiments/single_matrix_benchmarks/magic_fixed_gain/audit.py\"",
          "continue-on-error": true
        },
        {
          "name": "Permanently archive all available results",
          "run": "set -euo pipefail\ngit config user.name 'github-actions[bot]'\ngit config user.email '41898282+github-actions[bot]@users.noreply.github.com'\nif [ -d \"experiments/single_matrix_benchmarks/magic_fixed_gain/results\" ]; then git add -f \"experiments/single_matrix_benchmarks/magic_fixed_gain/results\"; git diff --cached --quiet || git commit -m 'Archive fixed-gain MAGIC development runs and diagnostics'; git push origin HEAD:\"$GITHUB_REF_NAME\"; fi"
        },
        {
          "if": "${{ always() }}",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "fixed-gain-analysis",
            "path": "experiments/single_matrix_benchmarks/magic_fixed_gain/results/analysis/",
            "if-no-files-found": "warn"
          }
        },
        {
          "name": "Require complete audit",
          "run": "python -c 'import json,sys; j=json.load(open(sys.argv[1])); assert j[\"complete\"] and j[\"n_grid\"]==14 and j[\"n_checkpoints\"]==84 and not j[\"audit_errors\"]' \"experiments/single_matrix_benchmarks/magic_fixed_gain/results/analysis/summary.json\""
        }
      ]
    }
  }
}
